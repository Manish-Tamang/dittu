{
  "name": "@manishtamang/dittu",
  "version": "0.2.0",
  "description": "Clone any website's frontend (layout, CSS, fonts, images, animations) into Next.js or Astro, verified by pixel diff. CLI + MCP server + agent skills.",
  "keywords": [
    "agent-skills",
    "astro",
    "claude-code",
    "mcp",
    "model-context-protocol",
    "nextjs",
    "playwright",
    "react",
    "visual-regression",
    "website-cloner"
  ],
  "homepage": "https://github.com/Manish-Tamang/dittu#readme",
  "bugs": {
    "url": "https://github.com/Manish-Tamang/dittu/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manish-Tamang/dittu.git"
  },
  "bin": {
    "dittu": "scripts/dittu.mjs"
  },
  "files": [
    "dist",
    "bridge",
    "scripts/dittu.mjs",
    ".agents/skills",
    "README.md",
    "DISCLAIMER.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "start": "node scripts/dittu.mjs mcp",
    "doctor": "node scripts/dittu.mjs doctor",
    "setup": "node scripts/dittu.mjs setup",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:coverage": "vitest run --project unit --coverage.enabled --coverage.provider=v8",
    "test:watch": "vitest --project unit",
    "benchmark": "node scripts/benchmark.mjs",
    "prepublishOnly": "pnpm check && pnpm build",
    "fixtures:images": "node tests/fixtures/make-images.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "comma-separated-tokens": "^2.0.3",
    "commander": "^15.0.0",
    "css-select": "^7.0.0",
    "estree-util-to-js": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-estree": "^3.1.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.31",
    "postcss-safe-parser": "^7.1.0",
    "postcss-selector-parser": "^7.1.7",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "property-information": "^7.2.0",
    "space-separated-tokens": "^2.0.2",
    "style-to-js": "^2.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/estree-jsx": "^1.0.5",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/postcss-safe-parser": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,mjs,js,json,md}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{ts,mjs,js}": "oxlint --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@12.8.1",
  "mcpName": "io.github.Manish-Tamang/dittu"
}
