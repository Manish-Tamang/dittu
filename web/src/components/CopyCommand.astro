---
import Icon from './Icon.astro';

interface Props {
  command: string;
  compact?: boolean;
  class?: string;
}

const { command, compact = false, class: className } = Astro.props;
---

<div
  class:list={[
    'flex h-10 w-full max-w-full items-center gap-3 rounded-lg border border-white/10 bg-neutral-950 pr-1.5 text-left font-mono text-neutral-300 sm:w-auto',
    compact ? 'pl-3 text-xs' : 'pl-4 text-[0.8125rem]',
    className,
  ]}
>
  {!compact && <span class="select-none text-neutral-600">$</span>}
  <code class="min-w-0 flex-1 truncate">{command}</code>
  <button
    type="button"
    data-copy={command}
    class="group grid size-7 shrink-0 place-items-center rounded-md text-neutral-500 transition-colors hover:bg-white/10 hover:text-white"
    aria-label="Copy command"
  >
    <Icon name="copy" class="size-3.5 group-data-[copied]:hidden" />
    <Icon name="check" class="hidden size-3.5 text-emerald-400 group-data-[copied]:block" />
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.dataset.copied = '';
      setTimeout(() => delete button.dataset.copied, 1500);
    });
  }
</script>
