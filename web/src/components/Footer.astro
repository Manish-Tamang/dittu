---
import { getCollection } from 'astro:content';
import { AUTHOR, NPM, REPO } from '../data';

const docs = (await getCollection('docs'))
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
  .map((doc) => ({ name: doc.data.title, href: `/docs/${doc.id}` }));

const project = [
  { name: 'GitHub', href: REPO },
  { name: 'npm', href: NPM },
  { name: 'Releases', href: `${REPO}/releases` },
  { name: 'Changelog', href: `${REPO}/blob/main/CHANGELOG.md` },
];
const legal = [
  { name: 'Disclaimer', href: `${REPO}/blob/main/DISCLAIMER.md` },
  { name: 'Contributing', href: `${REPO}/blob/main/CONTRIBUTING.md` },
  { name: 'Security', href: `${REPO}/blob/main/SECURITY.md` },
  { name: 'MIT License', href: `${REPO}/blob/main/LICENSE` },
];
const columns = [
  { title: 'Docs', links: docs },
  { title: 'Project', links: project },
  { title: 'Legal', links: legal },
];
---

<footer class="border-t border-white/10">
  <div class="mx-auto grid max-w-[1080px] gap-12 border-x border-white/10 px-5 py-16 sm:px-10 md:grid-cols-[1.5fr_repeat(3,1fr)]">
    <div>
      <a href="/" class="font-display text-xl font-bold tracking-tight text-white">dittu</a>
      <p class="mt-3 max-w-xs text-sm/6 text-neutral-500">
        Clone any website's frontend into Next.js or Astro, verified pixel by pixel.
      </p>
    </div>
    {
      columns.map((column) => (
        <div>
          <h2 class="text-sm font-medium text-white">{column.title}</h2>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                  class="text-sm text-neutral-500 transition-colors hover:text-white"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-[1080px] flex-col gap-3 border-x border-white/10 px-5 py-6 text-xs text-neutral-600 sm:px-10 md:flex-row md:items-center md:justify-between"
    >
      <p>MIT licensed. Cloning a site doesn't give you rights to its brand, copy, images or code.</p>
      <p class="flex items-center gap-2 text-neutral-500">
        A project by
        <a href={AUTHOR.href} target="_blank" rel="noreferrer" class="text-neutral-300 transition-colors hover:text-white"
          >{AUTHOR.handle}</a
        >
        <span class="text-neutral-700">·</span>
        <a href={AUTHOR.site} target="_blank" rel="noreferrer" class="text-neutral-300 transition-colors hover:text-white"
          >{AUTHOR.site.replace('https://', '')}</a
        >
      </p>
    </div>
  </div>
</footer>
