---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import Icon from '../../components/Icon.astro';
import { getSections } from '../../lib/docs';
import { breadcrumbSchema } from '../../lib/seo';

const sections = await getSections();
const schema = [
  breadcrumbSchema([
    { name: 'Home', url: new URL('/', Astro.site) },
    { name: 'Docs', url: new URL('/docs', Astro.site) },
  ]),
];
---

<DocsLayout
  title="Docs · dittu"
  description="Install dittu, use the CLI and MCP server, and learn how the clone pipeline and fidelity scoring work."
  schema={schema}
>
  <article class="mx-auto w-full max-w-3xl px-5 py-10 sm:px-8 lg:px-12 lg:py-14">
    <p class="text-sm font-medium text-neutral-500">Introduction</p>
    <h1 class="mt-2 font-display text-3xl font-medium tracking-tight text-white sm:text-4xl">dittu docs</h1>
    <p class="mt-3 text-lg/8 text-neutral-400">
      dittu turns any website into an editable Next.js or Astro project and proves the result with pixel diffs. Use
      it from the terminal, or let your coding agent drive it through the MCP server.
    </p>

    <h2 class="mt-12 font-display text-xl font-medium text-white">Quick start</h2>
    <p class="mt-2 text-sm/6 text-neutral-400">Check your machine, then register dittu with your agents:</p>
    <div class="mt-4 flex flex-col gap-2">
      <CopyCommand command="npx @manishtamang/dittu doctor" class="sm:w-full" />
      <CopyCommand command="npx @manishtamang/dittu setup" class="sm:w-full" />
    </div>

    {
      sections.map((section) => (
        <section class="mt-12">
          <h2 class="font-display text-xl font-medium text-white">{section.title}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {section.docs.map((doc) => (
              <li>
                <a
                  href={`/docs/${doc.id}`}
                  class="group flex h-full flex-col rounded-xl border border-white/10 p-4 transition-colors hover:border-white/20 hover:bg-white/[0.02]"
                >
                  <span class="flex items-center justify-between font-medium text-white">
                    {doc.data.title}
                    <Icon
                      name="arrow"
                      class="size-3.5 text-neutral-600 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-white"
                    />
                  </span>
                  <span class="mt-1 line-clamp-2 text-sm/6 text-neutral-500">{doc.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</DocsLayout>
